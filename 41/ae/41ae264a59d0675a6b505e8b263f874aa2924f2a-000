<table>
  <tr><td>新しい (あたらしい)</td><td>nouveau, récent</td></tr>
  <tr><td>新幹線 (しんかんせん)</td><td>Shinkansen (TGV japonais)</td></tr>
  <tr><td>新聞 (しんぶん)</td><td>journal (nouvelles)</td></tr>
  <tr><td>最新 (さいしん)</td><td>le plus récent</td></tr>
</table>

